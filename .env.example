# ─── Supabase ────────────────────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose to the client, server-side only
# Used for admin writes (invite emails, subscription updates)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ────────────────────────────────────────────────────────────────────
# Your Claude API key — server-side only, never expose to the client
ANTHROPIC_API_KEY=sk-ant-...

# ─── Resend (transactional email) ─────────────────────────────────────────────────
# Sign up at https://resend.com — used for trip invite emails and price alerts
# See TODO_SEND_EMAIL comments in /lib/emails/ for wiring up
RESEND_API_KEY=re_...

# ─── App URL ─────────────────────────────────────────────────────────────────────
# Full public URL of the app (no trailing slash) — used in email templates and OG tags
NEXT_PUBLIC_APP_URL=https://driftplan.app

# ─── Optional: Stripe (payments) ─────────────────────────────────────────────────
# Required to activate the Pro subscription upgrade flow
# See TODO_PAYMENT_LINK comments in /app/pricing/page.tsx
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Optional: Exchange rate API ─────────────────────────────────────────────────
# /api/tools/currency uses open.er-api.com which is free with no key required.
# If you need higher rate limits or historical data, add a key here.
# EXCHANGE_RATE_API_KEY=your-key
